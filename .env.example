# ==============================================================================
# Acedra Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env and fill in the appropriate values for your environment.
# DO NOT commit the actual .env file containing production secrets to version control.

# Application Environment ('local', 'staging', or 'production')
ENVIRONMENT=local

# Database Connection URL (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/acedra

# JWT Security
# In 'local' environment, this secret is used directly.
# In 'production', Acedra automatically fetches the secret from AWS Secrets Manager ("acedra/jwt").
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-local-dev

# AWS Cloud Services
AWS_REGION=ap-south-1
S3_BUCKET_NAME=acedra-documents-bucket-name
